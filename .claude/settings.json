{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit-check.cjs",
            "timeout": 60,
            "statusMessage": "Linting and testing after edit..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-check.cjs",
            "timeout": 60,
            "statusMessage": "Running lint + tests before commit..."
          }
        ]
      }
    ]
  }
}
